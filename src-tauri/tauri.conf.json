{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GdC",
  "version": "1.3.0",
  "identifier": "com.certificados.gen",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Gerador de Certificados",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-installer-hooks.nsh"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    },
    "publisher": "Yann Dezedias",
    "copyright": "© 2025 Yann Dezedias",
    "category": "Utility",
    "shortDescription": "Gerador de Certificados em PDF",
    "longDescription": "Gerador de Certificados — crie certificados em PDF a partir de modelos, com assinatura digital e geração em lote."
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RUNFNTZFMkRERTJDRDcKUldUWExONHRidVhzNktESTJiOTNpaGNOMVh0UHRqNzFzUllYaGNJYTR2Z2o2bWtZMXBoVnF3UEcK",
      "endpoints": [
        "https://github.com/DezediasYann/gerador-de-certificados/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}
